rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /bookingSlots/{slotId} {
      allow get, list: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly([
          'uid', 'serviceId', 'therapist', 'date', 'time', 'status', 'createdAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.serviceId in ['facelift', 'bach', 'riqueza']
        && request.resource.data.therapist in ['daniela', 'judith']
        && (request.resource.data.serviceId != 'facelift' || request.resource.data.therapist == 'daniela')
        && request.resource.data.date is string
        && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.time in [
          '08:00 - 09:00 hrs', '09:00 - 10:00 hrs',
          '10:00 - 11:00 hrs', '11:00 - 12:00 hrs',
          '12:00 - 13:00 hrs', '13:00 - 14:00 hrs',
          '14:00 - 15:00 hrs', '15:00 - 16:00 hrs',
          '16:00 - 17:00 hrs', '17:00 - 18:00 hrs',
          '18:00 - 19:00 hrs', '19:00 - 20:00 hrs'
        ]
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time;

      allow delete: if request.auth != null
        && resource.data.uid == request.auth.uid
        && resource.data.status == 'pending';

      allow update: if false;
    }
  }
}

